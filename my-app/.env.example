# =============================================================================
# Environment Variables - copy this file to .env.local and fill in the values.
# Lines starting with # are comments. Never commit .env.local to git.
# =============================================================================

# =============================================================================
# REQUIRED - the app will not start without these
# =============================================================================

# MongoDB Atlas connection string
# Atlas dashboard: Database > Connect > Drivers > Node.js
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/asana?retryWrites=true&w=majority

# Auth.js session secret - must be a long random string
# Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials
# https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (production): https://your-domain.example.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# =============================================================================
# OPTIONAL - features are disabled / no-op when these are absent
# =============================================================================

# -- App ----------------------------------------------------------------------
# Use http://localhost:3000 for local demo emails/links.
APP_URL=http://localhost:3000

# -- Cron / background jobs ---------------------------------------------------
# Bearer token that the scheduler must send to /api/cron/* endpoints.
CRON_SECRET=

# -- Email providers ----------------------------------------------------------
# Resend is preferred when RESEND_API_KEY is present. Set EMAIL_FROM with it.
RESEND_API_KEY=
EMAIL_FROM=GeneGenius OpsHub <noreply@example.com>

# SMTP is used when Resend is absent and all SMTP fields are set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# -- Real-time (Pusher) -------------------------------------------------------
# Set all six or none.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# -- File upload --------------------------------------------------------------
# Built-in default when unset is "google-drive".
# Local personal Drive demo: use google-oauth.
# Service-account Shared Drive demo: use google-drive.
# Production (see Docs/DEPLOYMENT-IMPLEMENTATION.md) uses s3.
UPLOAD_PROVIDER=google-oauth

# UploadThing direct binary uploads.
UPLOADTHING_TOKEN=

# Google Drive via Service Account / Shared Drive
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWx

# Google Drive via OAuth2 (recommended for personal Gmail local demos)
# Add redirect URI: http://localhost:5555/oauth2callback
# Run: npx tsx --env-file=.env.local scripts/google-oauth-token.ts
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Amazon S3
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -- Rate limiting (Upstash Redis) --------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Error monitoring (Sentry) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -- AWS spend report ----------------------------------------------------------
# Slug of the single private workspace allowed to see the spend report feature.
# Leave unset to disable the feature entirely.
FINANCE_WORKSPACE_SLUG=

# -- GG-Docs -------------------------------------------------------------------
# GG-Docs base URL (https). Shows "Open in GG-Docs" in the workspace sidebar.
# Leave unset to hide it.
GGDOCS_URL=

# -- Inbound email -> task (V5) ------------------------------------------------
# Turns emails sent to the ingestion mailbox into GGOps tasks.
#
# OFF unless INBOUND_EMAIL_ENABLED is exactly "true". Keep it that way until you have
# read the security notes in Docs/AI-INTEGRATION-TRACKER.md: this feature feeds
# attacker-controllable content (anyone can send an email) to an LLM that then creates
# tasks. It is safe because the sender must pass DMARC AND already be an active member of
# the target project's workspace — but that only holds if those gates stay in place.
# INBOUND_EMAIL_ENABLED=true
#
# Gmail OAuth client. Deliberately separate from GOOGLE_OAUTH_* (the Drive uploader) so a
# Drive token never doubles as mailbox access. Needs scope:
#   https://www.googleapis.com/auth/gmail.modify
# ("readonly" is not enough — processed mail is labelled, and that labelling is the dedupe
# store, which is why no new database collection was needed.)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
#
# Claude, for turning an email into structured task fields.
# Defaults to claude-haiku-4-5 — this runs on every inbound message, so it is deliberately
# the cheap tier. Override only if extraction quality proves insufficient.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# -- Seed script --------------------------------------------------------------
# SEED_EMAIL=test@example.com
# SEED_PASSWORD=password123
